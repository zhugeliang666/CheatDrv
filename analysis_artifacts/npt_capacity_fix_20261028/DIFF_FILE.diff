diff --git a/vt/VtHypervisor/amd/npt.cpp b/vt/VtHypervisor/amd/npt.cpp
index 229bc10..87dd5ed 100644
--- a/vt/VtHypervisor/amd/npt.cpp
+++ b/vt/VtHypervisor/amd/npt.cpp
@@ -74,8 +74,11 @@ static bool split_2mb_pde(npt_data& npt, u64 const physical_address) {
