-extern "C" __declspec(dllexport) VOID NTAPI SubclassInitEntry(
-    PVOID NormalContext,
-    PVOID SystemArgument1,
-    PVOID SystemArgument2)
-{
-    UNREFERENCED_PARAMETER(SystemArgument1);
-    UNREFERENCED_PARAMETER(SystemArgument2);
